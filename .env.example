# --- App ---
ENV=local

# --- Telegram Bot ---
BOT_TOKEN=your_bot_token_here
BOT_DEBUG=true

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=habits
DB_PASSWORD=habits
DB_NAME=habits
DB_SSLMODE=disable

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest